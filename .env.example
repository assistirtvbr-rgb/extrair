# LeadMap Environment Variables
# Front-end public configuration

# Cloudflare Worker API URL (local dev or deployed worker)
VITE_WORKER_API_URL=http://localhost:8787/api/search

# Optional: Google Maps JS API key for client-side map rendering (or leave empty to use built-in interactive OpenStreetMap/Leaflet renderer)
VITE_GOOGLE_MAPS_KEY=
